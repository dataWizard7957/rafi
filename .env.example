# ---------- Google ----------
GOOGLE_CLOUD_PROJECT=rafi-hack
GOOGLE_CLOUD_LOCATION=us-central1
# Verify both IDs in Vertex AI Model Garden before the demo
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_VISION_LOCATION=global
# Leave empty for local dev (photos saved to /tmp). Required on Cloud Run.
GCS_BUCKET=

# ---------- IBM watsonx Orchestrate (Tokyo). No watsonx.ai Runtime. ----------
ORCHESTRATE_URL=
ORCHESTRATE_APIKEY=
ORCHESTRATE_MANAGER_AGENT=rafi_manager
# Verify against the current Orchestrate API reference
ORCHESTRATE_RUN_PATH=/v1/orchestrate/runs

# ---------- App ----------
SHOP_ID=cedar-and-date
RAFI_KEY=change-me-long-random-string
ALLOWED_ORIGINS=*
